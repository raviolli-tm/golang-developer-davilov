FROM golang:1.23-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG LDFLAGS=""
RUN CGO_ENABLED=0 GOOS=linux go build \
        -trimpath \
        -ldflags "$LDFLAGS" \
        -o /out/calendar-scheduler ./cmd/calendar_scheduler

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 app

COPY --from=build /out/calendar-scheduler /usr/local/bin/calendar-scheduler
COPY configs/scheduler_config.yaml /etc/calendar/scheduler_config.yaml

USER app

ENTRYPOINT ["/usr/local/bin/calendar-scheduler"]
CMD ["-config", "/etc/calendar/scheduler_config.yaml"]
