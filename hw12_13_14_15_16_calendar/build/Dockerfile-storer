FROM golang:1.23-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG LDFLAGS=""
RUN CGO_ENABLED=0 GOOS=linux go build \
        -trimpath \
        -ldflags "$LDFLAGS" \
        -o /out/calendar-storer ./cmd/calendar_storer

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 app

COPY --from=build /out/calendar-storer /usr/local/bin/calendar-storer
COPY configs/storer_config.yaml /etc/calendar/storer_config.yaml

USER app

ENTRYPOINT ["/usr/local/bin/calendar-storer"]
CMD ["-config", "/etc/calendar/storer_config.yaml"]
